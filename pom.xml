<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>es.jllopez</groupId>
    <artifactId>neis</artifactId>
    <!-- The distribution version lives ONLY in the neis.version
         property below — changing it changes the Maven project
         version (jar name, build-info, /api/system), the
         distribution package name (neis-dist-<neis.version>.tar.gz)
         and the reported MCP server version (application.yml filters
         @neis.version@). Never bump a version anywhere else. -->
    <version>${neis.version}</version>
    <name>neis</name>
    <description>NEIS - News and Events Information System (CLI application on a hexagonal architecture)</description>

    <properties>
        <!-- THE version of the NEIS distribution — the only place it
             may be changed (see the comment on <version> above). -->
        <neis.version>0.40</neis.version>
        <java.version>21</java.version>
        <spring-shell.version>4.0.3</spring-shell.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <archunit.version>1.5.1</archunit.version>
        <jsoup.version>1.24.1</jsoup.version>
        <readability4j.version>1.0.8</readability4j.version>
        <tika.version>4.2.0</tika.version>
        <playwright.version>1.65.0</playwright.version>
        <rome.version>2.1.0</rome.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- US-18.6 (issue #121): the web stack for the SERVER run mode
             (REST API + MCP remote adapters). On the classpath ALWAYS,
             but inert in CLI mode: spring.main.web-application-type=none
             (the application.yml default) backs the web server
             auto-configuration off, so one-shot CLI invocations behave
             and EXIT exactly as before. server.sh flips the type to
             servlet together with neis.server.enabled=true. -->
        <dependency>
        	<groupId>org.springframework.boot</groupId>
        	<artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- US-18.5 (issue #120): the OpenAPI spec + Swagger UI for the
             REST surface. Version 3.2.x is the Boot 4.1 release train
             (maven-metadata: its parent is spring-boot-starter-parent
             4.1.2). -->
        <dependency>
        	<groupId>org.springdoc</groupId>
        	<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        	<version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.shell</groupId>
            <artifactId>spring-shell-starter-jansi</artifactId>
            <version>${spring-shell.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <!-- US-18.3 (issue #118): the MCP server driving adapter over
             Streamable HTTP. Same Spring AI line as the AI integration
             (2.0.x; 2.1 is still milestone/RC). The starter's
             auto-configuration is GATED: spring.ai.mcp.server.enabled
             tracks neis.server.enabled (application.yml), so one-shot
             CLI invocations never boot MCP. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- US-07.5 (issue #87): Readability4J main-content extraction —
             the PRIMARY extractor for article-like pages behind
             SimplifyPort (Apache 2.0; its POM declares jsoup 1.11.2,
             verified compatible with the pinned jsoup 1.24.1 by probe). -->
        <dependency>
            <groupId>net.dankito.readability4j</groupId>
            <artifactId>readability4j</artifactId>
            <version>${readability4j.version}</version>
        </dependency>
        <!-- US-06.2 (issue #28): content-type/charset detection of the
             fetched pages (owner technology choice, 2026-11-11). -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- US-06.5 (issue #71): the rendered retrieval strategy — real
             browser rendering of client-side content (owner technology
             choice, 2026-11-11). LAZY: the driver and browser binaries
             provision on FIRST USE of the rendered connector, never at
             boot; offline and fixture runs never touch it. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- US-06.8 (issue #86): RSS/Atom feed sources — the proven
             open-source JVM feed parser the requirement names
             (Apache 2.0), behind the same ports. -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>${rome.version}</version>
        </dependency>

        <!-- Persistence layer (US-02, epic #2): ORM over SQLite3. All DB
             access stays behind repository ports (owner decision recorded
             in issue #15). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- SQLite3 JDBC driver; version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <!-- Hibernate community dialects (SQLiteDialect); version locked to
             the Hibernate ORM version the Boot BOM manages. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <!-- Schema migrations (US-02.3); versions managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Distribution packaging and system-service lifecycle. The dist
         package (target/neis-dist-<version>.tar.gz) carries everything
         systemd/install.sh needs — the packaged jar, the core kit and
         the installer itself — so it installs on a machine with NO
         repository checkout (untar anywhere, run
         ./systemd/install.sh install). The exec goals drive the
         repository build's installer directly:

           ./dist.sh                            THE entry point: bumps
                                                the MINOR version when
                                                tracked sources changed
                                                since the last dist
                                                build (auto-commit),
                                                then runs package
           mvn -Pdist package                    generate the package
           mvn -Pdist exec:exec@neis-install     install (stop-if-running, deploy, start)
           mvn -Pdist exec:exec@neis-upgrade     upgrade (stop-if-running, deploy, restart-if-was-running)
           mvn -Pdist exec:exec@neis-uninstall   remove the service (data kept)
           mvn -Pdist exec:exec@neis-status      service + health status

         The installer refuses to deploy when sources are newer than the
         jar — run a plain `mvn -Pdist package` first (its allow-stale
         option overrides that deliberately). -->
    <profiles>
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.8.0</version>
                        <configuration>
                            <descriptors>
                                <descriptor>systemd/dist-assembly.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>neis-dist-${project.version}</finalName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>dist-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.7.0</version>
                        <configuration>
                            <executable>${project.basedir}/systemd/install.sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>neis-install</id>
                                <configuration>
                                    <arguments>
                                        <argument>install</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>neis-upgrade</id>
                                <configuration>
                                    <arguments>
                                        <argument>upgrade</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>neis-uninstall</id>
                                <configuration>
                                    <arguments>
                                        <argument>uninstall</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>neis-status</id>
                                <configuration>
                                    <arguments>
                                        <argument>status</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
