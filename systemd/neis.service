# NEIS - News and Events Information System, server run mode
# (REST API + MCP endpoint over Streamable HTTP on /mcp).
#
# User-level unit, same convention as hermes-gateway/hermes-dashboard on
# this host. %h expands to the installing user's home.
#
# The environment (bind, port, store/kit paths) lives in
# %h/.local/share/neis/neis.env, generated by systemd/install.sh — edit
# there, then `systemctl --user restart neis`.

[Unit]
Description=NEIS server (REST + MCP over Streamable HTTP)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/neis
EnvironmentFile=%h/.local/share/neis/neis.env
ExecStart=%h/.local/share/neis/server.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
# US-15.6 (issue #131): the JVM's default TERM exit status (143) must
# never count as a unit failure — the app's own SIGTERM handler exits
# 0, this covers the residual case of the JVM dying ON the signal.
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
