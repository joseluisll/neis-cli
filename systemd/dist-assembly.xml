<?xml version="1.0" encoding="UTF-8"?>
<!-- Distribution package for the NEIS system (Maven profile `dist`).
     Everything systemd/install.sh needs to install the server on a
     machine WITHOUT a repository checkout: the packaged fat jar, the
     core kit and the installer itself. The archive layout matches the
     installer's expectations (lib/neis-*.jar, core/, server.sh,
     start.sh, systemd/), so untarring anywhere and running
     ./systemd/install.sh install works unmodified. The installer maps
     the kit's runtime store (core/work in the repository) to the
     installed core/data.

     No filtering is configured on purpose: the shell scripts must be
     copied byte-for-byte (the tar format preserves their exec bits). -->
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly/1.1.3">
    <id>dist</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <fileSets>
        <!-- The repackaged Spring Boot fat jar (spring-boot-maven-plugin
             runs repackage in the same phase, before this assembly). The
             installed layout names this directory lib/ (not Maven's
             target/). -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>neis-*.jar</include>
            </includes>
            <excludes>
                <exclude>*.original</exclude>
            </excludes>
        </fileSet>
        <!-- The core kit: run/show/start scripts, seed selectors and the
             work/ store so a fresh install boots with the seeded kit. -->
        <fileSet>
            <directory>${project.basedir}/core</directory>
            <outputDirectory>core</outputDirectory>
        </fileSet>
        <!-- Launchers, copied unmodified. -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>server.sh</include>
                <include>start.sh</include>
            </includes>
        </fileSet>
        <!-- The installer itself and the systemd unit template. -->
        <fileSet>
            <directory>${project.basedir}/systemd</directory>
            <outputDirectory>systemd</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
